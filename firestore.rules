rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function ownsUser() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasNoLegacyProviderKeys(data) {
        return !('zsky_keys' in data)
               && !('agnes_keys' in data)
               && !('glm_keys' in data);
      }

      allow read: if ownsUser() && hasNoLegacyProviderKeys(resource.data);
      allow create, update: if ownsUser()
                            && hasNoLegacyProviderKeys(request.resource.data);
      allow delete: if ownsUser();

      match /stories/{storyId} {
        function ownsStory() {
          return request.auth != null && request.auth.uid == userId;
        }

        allow read, delete: if ownsStory();
        allow create: if ownsStory()
                      && request.resource.data.storyName is string
                      && request.resource.data.script == ''
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.imageCount == 0
                      && request.resource.data.storageBytes == 0;
        allow update: if ownsStory()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['script'])
                      && request.resource.data.script is string;

        match /images/{imageId} {
          allow read: if ownsStory();
          // Image documents and counters are written only by the authenticated API server.
          allow create, update, delete: if false;
        }
      }

      match /providerKeys/{provider}/keys/{keyId} {
        // Provider key documents are accessible only through the Admin SDK vault API.
        allow read, write: if false;
      }
    }
  }
}
