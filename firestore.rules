rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /stories/{storyId} {
        function ownsStory() {
          return request.auth != null && request.auth.uid == userId;
        }

        allow read, delete: if ownsStory();
        allow create: if ownsStory()
                      && request.resource.data.storyName is string
                      && request.resource.data.script == ''
                      && request.resource.data.createdAt is timestamp
                      && request.resource.data.imageCount == 0
                      && request.resource.data.storageBytes == 0;
        allow update: if ownsStory()
                      && request.resource.data.storyName == resource.data.storyName
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.script is string
                      && request.resource.data.imageCount is int
                      && request.resource.data.imageCount >= 0
                      && request.resource.data.imageCount <= 100
                      && request.resource.data.storageBytes is int
                      && request.resource.data.storageBytes >= 0;

        match /images/{imageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
